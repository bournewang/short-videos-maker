# Shortform Studio provider configuration
# Copy this file to .env.local and add your real keys. Never commit .env.local.
#
# Naming scheme (recommended):
#   {PROVIDER}_API_KEY            one shared key per provider
#   {PROVIDER}_{MODALITY}_ENDPOINT optional endpoint override per modality
#   {PROVIDER}_{MODALITY}_MODEL   model name per provider and modality
#   {MODALITY}_PROVIDER           selects the active provider per modality
#
# Because model names are prefixed with the provider, switching VIDEO_PROVIDER
# never leaks a model name into another provider's requests.
#
# Legacy fallback: the un-prefixed {MODALITY}_MODEL (TEXT_MODEL, IMAGE_MODEL,
# VIDEO_MODEL) still works, but only applies to the currently selected
# {MODALITY}_PROVIDER and is ignored by every other provider.


# Provider: Volcengine Ark
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLCENGINE_VIDEO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks
VOLCENGINE_TEXT_MODEL=doubao-seed-2-1-turbo-260628
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128
VOLCENGINE_VIDEO_MODEL=doubao-seedance-2-0-260128

# Provider: Aliyun Bailian (DashScope) — Wan video, Qwen image
DASHSCOPE_API_KEY=
# DASHSCOPE_HOST=https://llm-xxxxxx.cn-beijing.maas.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
DASHSCOPE_VIDEO_MODEL=wan3.0-video

# Provider: PixStag (MiniMax-H3 video) — endpoint defaults to https://pixstag.com
PIXSTAG_API_KEY=
PIXSTAG_VIDEO_MODEL=MiniMax-H3

# Provider: MiniMax TTS (t2a_v2) — AI narration for the episode and digital-human
# screens. The same key powers voice listing and speech synthesis; MiniMax returns
# a word/sentence-timed subtitle file that replaces local speech-to-text.
MINIMAX_API_KEY=

# Provider: Doubao (Volcengine Speech) TTS — seed-tts-2.0 大模型语音合成。
# Uses the new X-Api-Key auth (no Access Token). API Key is created in the
# 语音技术控制台 → API Key 管理. Powers the Chinese "story" genre narration
# (悬疑解说 2.0 male voice). Returns sentence/word timestamps via the async
# submit → query flow.
DOUBAO_TTS_API_KEY=

# Aliyun OSS — first-frame storage for PixStag image-to-video. PixStag only
# accepts a publicly reachable image URL, so local storyboard frames are
# uploaded to a private bucket and passed as a 15-minute presigned URL.
# Use a RAM sub-account with oss:PutObject on this bucket only (not your
# root account keys). Keep the bucket private; do not enable public read.
OSS_REGION=cn-beijing
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Active provider selection
TEXT_PROVIDER=volcengine
IMAGE_PROVIDER=volcengine
VIDEO_PROVIDER=volcengine

# Runtime behavior
SHORTFORM_STORAGE_DIR=.shortform
TEXT_REQUEST_TIMEOUT_MS=120000
VIDEO_REQUEST_TIMEOUT_MS=900000
VIDEO_POLL_INTERVAL_MS=5000
SPEECH_REQUEST_TIMEOUT_MS=600000

# Local MLX Audio text-to-speech service. A base URL or complete /v1/audio/speech URL is accepted.
SPEECH_ENDPOINT=http://localhost:8010/v1/audio/speech
SPEECH_MODEL=mlx-community/Kokoro-82M-bf16
SPEECH_VOICE=af_heart
SPEECH_LANGUAGE=a
SPEECH_SPEED=1

# Local speech-to-text service. Narration audio is posted as multipart form data.
TRANSCRIPTION_ENDPOINT=http://localhost:8000/v1/transcriptions
TRANSCRIPTION_LANGUAGE=en
