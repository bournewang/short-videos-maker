# Shortform Studio provider configuration
# Copy this file to .env.local and add your real keys. Never commit .env.local.

# A single OpenAI-compatible key can power both image generation and translation.
OPENAI_API_KEY=

# Optional image-provider overrides.
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_API_ENDPOINT=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1

# Optional translation-provider overrides.
TEXT_PROVIDER=openai
TEXT_API_KEY=
TEXT_API_ENDPOINT=https://api.openai.com/v1/chat/completions
TEXT_MODEL=gpt-4.1-mini

# Volcengine Ark can power both Seedream images and Doubao text analysis.
# Set IMAGE_PROVIDER and TEXT_PROVIDER to volcengine, then provide an activated
# Ark text model (or ep-... endpoint ID) from your account.
VOLCENGINE_API_KEY=
VOLCENGINE_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128
VOLCENGINE_TEXT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_TEXT_MODEL=doubao-seed-2-1-turbo-260628
TEXT_REQUEST_TIMEOUT_MS=120000

# Local speech-to-text service. Narration audio is posted as multipart form data.
TRANSCRIPTION_ENDPOINT=http://localhost:8000/v1/transcriptions
TRANSCRIPTION_LANGUAGE=en
