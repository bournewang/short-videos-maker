# Shortform Studio provider configuration
# Copy this file to .env.local and add your real keys. Never commit .env.local.

# Provider: OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_ENDPOINT=https://api.openai.com/v1/chat/completions
OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations

# Provider: Volcengine Ark
VOLCENGINE_API_KEY=
VOLCENGINE_TEXT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLCENGINE_VIDEO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks

# Agent Plan alternative (use its API key and non-versioned plan model names):
# VOLCENGINE_TEXT_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3
# VOLCENGINE_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3
# VOLCENGINE_VIDEO_ENDPOINT=https://ark.cn-beijing.volces.com/api/plan/v3
# TEXT_MODEL=ark-code-latest
# IMAGE_MODEL=doubao-seedream-5.0-lite
# VIDEO_MODEL=doubao-seedance-2.0

# Active text configuration
TEXT_PROVIDER=volcengine
TEXT_MODEL=doubao-seed-2-1-turbo-260628

# Active image configuration
IMAGE_PROVIDER=volcengine
IMAGE_MODEL=doubao-seedream-5-0-260128

# Active video configuration
VIDEO_PROVIDER=volcengine
VIDEO_MODEL=doubao-seedance-2-0-260128

# Runtime behavior
SHORTFORM_STORAGE_DIR=.shortform
TEXT_REQUEST_TIMEOUT_MS=120000
VIDEO_REQUEST_TIMEOUT_MS=900000
VIDEO_POLL_INTERVAL_MS=5000
SPEECH_REQUEST_TIMEOUT_MS=600000

# Local MLX Audio text-to-speech service. A base URL or complete /v1/audio/speech URL is accepted.
SPEECH_ENDPOINT=http://localhost:8010/v1/audio/speech
SPEECH_MODEL=mlx-community/Kokoro-82M-bf16
SPEECH_VOICE=af_heart
SPEECH_LANGUAGE=a
SPEECH_SPEED=1

# Local speech-to-text service. Narration audio is posted as multipart form data.
TRANSCRIPTION_ENDPOINT=http://localhost:8000/v1/transcriptions
TRANSCRIPTION_LANGUAGE=en
